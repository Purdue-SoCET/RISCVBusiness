# ============================================================
# config.env for RISCVBusiness CI/CD
# ============================================================
#
# Configures the standard SoCET CI scripts:
#   ./setup.sh
#   ./build.sh
#   ./test.sh
#   ./lint.sh
#   ./synth.sh
#
# Keep this structurally aligned with SoCET-Template/config.env.
# Only edit repo-specific values or add knobs that should also be
# considered for the reusable template.
# ============================================================

# ============================================================
# Project metadata
# ============================================================

PROJECT_NAME="RISCVBusiness"

# ============================================================
# Setup behavior
# ============================================================

SETUP_ENABLED=1

# Clean old FuseSoC library state before adding dependencies.
SETUP_CLEAN_FUSESOC=1

# Install FuseSoC libraries required by RISCVBusiness.
INSTALL_FUSESOC_LIBRARIES=1

# FuseSoC dependency list.
#
# Format:
#   name|git_url
#
# These are SSH URLs while the repos are private. Once public, switch to:
#   https://github.com/Purdue-SoCET/digital-lib.git
#   https://github.com/Purdue-SoCET/bus-components.git
FUSESOC_LIBRARIES="
digital-lib|git@github.com:Purdue-SoCET/digital-lib.git
bus-components|git@github.com:Purdue-SoCET/bus-components.git
"

# Optional pre-commit hook installation.
INSTALL_PRECOMMIT_HOOK=0
PRECOMMIT_HOOK_SRC="./scripts/pre-commit"
PRECOMMIT_HOOK_DST="./.git/hooks/pre-commit"

# ============================================================
# Core configuration behavior
# ============================================================
#
# Replaces:
#   make config
# which used:
#   python3 scripts/config_core.py example.yml
# ============================================================

CONFIG_STEP_ENABLED=1
RISCV_CONFIG_SCRIPT="scripts/config_core.py"
RISCV_CONFIG_FILE="example.yml"

# ============================================================
# Build behavior
# ============================================================
#
# Replaces:
#   make verilate
# with a FuseSoC/Verilator build.
# ============================================================

BUILD_ENABLED=1

FUSESOC_BUILD_ENABLED=1
FUSESOC_BUILD_CMD=""

FUSESOC_CORES_ROOT="."
FUSESOC_CORE="socet:riscv:RISCVBusiness"
FUSESOC_TARGET="sim"
FUSESOC_TOOL="verilator"
FUSESOC_BUILD_ROOT="rvb_out"
FUSESOC_EXTRA_ARGS="--make_options=-j"
FUSESOC_VERILATOR_OPTIONS="-Wno-fatal -Wno-DEPRECATED -Wno-UNOPTFLAT"

# Optional pre/post build hooks.
PRE_BUILD_CMD=""
POST_BUILD_CMD=""

# ============================================================
# Test behavior
# ============================================================
#
# Runs RISCVBusiness RISC-V test setup, then a small ISA-I smoke test.
# ============================================================

TEST_ENABLED=1

# Test mode options:
#   sim, command, sources, none
TEST_MODE="command"

# Run riscv-tests setup before TEST_CMD.
RISCV_TEST_SETUP_ENABLED=1
RISCV_TEST_SETUP_CMD="bash ./setup-riscv-tests.sh isa"

# Small initial CI gate.
TEST_CMD="./run_riscv_tests.py --isa i --environment p"

# Timeout for test commands, in seconds.
TEST_TIMEOUT_SECONDS=1800

# Optional pass regex.
PASS_REGEX=""

# ============================================================
# Lint behavior
# ============================================================
#
# Replaces:
#   make lint
# with FuseSoC/Verilator lint plus optional Verible lint.
# ============================================================

LINT_ENABLED=1
LINT_STRICT=0
LINT_CMD=""

FUSESOC_LINT_ENABLED=1
FUSESOC_LINT_TARGET="lint"
FUSESOC_LINT_TOOL="verilator"
FUSESOC_LINT_BUILD_ROOT="rvb_out"
FUSESOC_LINT_EXTRA_ARGS=""

VERIBLE_LINT_ENABLED=1
VERIBLE_RULES_FILE=".rules.verible_lint"
VERIBLE_LINT_EXTENSIONS="sv v vh"
VERIBLE_LINT_EXCLUDE_DIRS="rvb_out synth_out fusesoc_libraries riscv-tests embench-1.0 .git"
FUSESOC_LINT_VERILATOR_OPTIONS="-Wno-fatal -Wno-DEPRECATED -Wno-UNOPTFLAT"

# ============================================================
# Synthesis behavior
# ============================================================
#
# Real synthesis is enabled for RISCVBusiness.
#
# The working open-source flow uses the dedicated FuseSoC synth target,
# extracts FuseSoC's ordered Yosys source list, converts SystemVerilog
# through sv2v, then runs the template mapped Yosys/OpenSTA reporting
# backend.
# ============================================================

SYNTH_ENABLED=1
SYNTH_MODE="fusesoc-yosys"
SYNTH_CMD=""
SYNTH_TOP="top_core"
SYNTH_OUT_DIR="synth_out"
SYNTH_LIBERTY="flow/lib/NangateOpenCellLibrary_typical.lib"
SYNTH_SDC="rvb.sdc"
SYNTH_OPENSTA_SCRIPT="flow/scripts/opensta_rvb.tcl"

# FuseSoC/Yosys source extraction mode.
SYNTH_FUSESOC_CORE="socet:riscv:RISCVBusiness"
SYNTH_FUSESOC_TARGET="synth"
SYNTH_FUSESOC_TOOL="yosys"
SYNTH_FUSESOC_BUILD_ROOT="synth_out"

# RISCVBusiness has simulation-only trackers/debug code in the FuseSoC list.
SYNTH_SOURCE_EXCLUDE_REGEX="tracker|monitor|debug|trace|stats|log"

# l1_cache.sv emits simulation-only $timeformat calls after sv2v conversion.
SYNTH_STRIP_TIMEFORMAT=1