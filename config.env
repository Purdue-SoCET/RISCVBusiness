# ============================================================
# config.env for RISCVBusiness CI/CD
# ============================================================
#
# This file configures the standard SoCET CI scripts:
#
#   ./setup.sh
#   ./build.sh
#   ./test.sh
#   ./lint.sh
#   ./synth.sh
#
# RISCVBusiness previously used Makefile targets such as:
#
#   make config
#   make verilate
#   make lint
#
# This CI flow moves those commands into script-controlled steps so the
# repo can be built and tested consistently in GitHub Actions and locally.
#
# ============================================================

# ============================================================
# Project metadata
# ============================================================

PROJECT_NAME="RISCVBusiness"

# ============================================================
# Setup behavior
# ============================================================
#
# setup.sh prepares FuseSoC libraries and other repository dependencies.
#
# For now, digital-lib and bus-components are still private repos, so the
# setup flow keeps the current SSH URLs. Once those dependencies are made
# public, they should be migrated to HTTPS URLs for open-source CI.
# ============================================================

SETUP_ENABLED=1

# Clean old FuseSoC library state before adding dependencies.
SETUP_CLEAN_FUSESOC=1

# Install FuseSoC libraries required by RISCVBusiness.
INSTALL_FUSESOC_LIBRARIES=1

# FuseSoC dependency list.
#
# Format:
#
#   name|git_url
#
# These are SSH URLs for now because the repos are currently private.
# Once public, switch to:
#
#   https://github.com/Purdue-SoCET/digital-lib.git
#   https://github.com/Purdue-SoCET/bus-components.git
#
FUSESOC_LIBRARIES="
digital-lib|git@github.com:Purdue-SoCET/digital-lib.git
bus-components|git@github.com:Purdue-SoCET/bus-components.git
"

# Optional pre-commit hook installation.
INSTALL_PRECOMMIT_HOOK=0
PRECOMMIT_HOOK_SRC="./scripts/pre-commit"
PRECOMMIT_HOOK_DST="./.git/hooks/pre-commit"

# ============================================================
# Core configuration behavior
# ============================================================
#
# This replaces:
#
#   make config
#
# which used:
#
#   python3 scripts/config_core.py example.yml
#
# ============================================================

CONFIG_STEP_ENABLED=1
RISCV_CONFIG_SCRIPT="scripts/config_core.py"
RISCV_CONFIG_FILE="example.yml"

# ============================================================
# Build behavior
# ============================================================
#
# This replaces:
#
#   make verilate
#
# which used:
#
#   fusesoc --cores-root . run --setup --build --build-root rvb_out \
#       --target sim --tool verilator socet:riscv:RISCVBusiness \
#       --make_options='-j'
#
# ============================================================

BUILD_ENABLED=1

FUSESOC_BUILD_ENABLED=1
FUSESOC_BUILD_CMD=""

FUSESOC_CORES_ROOT="."
FUSESOC_CORE="socet:riscv:RISCVBusiness"
FUSESOC_TARGET="sim"
FUSESOC_TOOL="verilator"
FUSESOC_BUILD_ROOT="rvb_out"
FUSESOC_EXTRA_ARGS="--make_options=-j"
FUSESOC_VERILATOR_OPTIONS="-Wno-fatal -Wno-DEPRECATED -Wno-UNOPTFLAT"

# Optional pre/post build hooks.
PRE_BUILD_CMD=""
POST_BUILD_CMD=""

# ============================================================
# Test behavior
# ============================================================
#
# test.sh should run the existing RISCVBusiness RISC-V test flow.
#
# First, it can run:
#
#   ./setup-riscv-tests.sh
#
# Then it runs a small initial smoke test:
#
#   ./run_riscv_tests.py --isa i --environment p
#
# The test setup step can be expensive, but it keeps CI reproducible.
# ============================================================

TEST_ENABLED=1

# Test mode options used by the template test.sh:
#
#   sim
#   command
#   sources
#   none
#
# For RISCVBusiness, use command mode and call the existing test runner.
TEST_MODE="command"

# Run riscv-tests setup before TEST_CMD.
RISCV_TEST_SETUP_ENABLED=1
RISCV_TEST_SETUP_CMD="bash ./setup-riscv-tests.sh isa"

# Small initial CI gate.
TEST_CMD="./run_riscv_tests.py --isa i --environment p"

# Timeout for test commands, in seconds.
#
# The RISCVBusiness test setup/build can take a while, especially on a cold
# CI runner, so keep this higher than the small counter template.
TEST_TIMEOUT_SECONDS=1800

# Optional pass regex.
#
# Leave empty because run_riscv_tests.py returns a process status and prints
# its own pass/fail summary.
PASS_REGEX=""

# ============================================================
# Lint behavior
# ============================================================
#
# This replaces:
#
#   make lint
#
# which used:
#
#   fusesoc --cores-root . run --setup --build --build-root rvb_out \
#       --target lint --tool verilator socet:riscv:RISCVBusiness
#
# ============================================================

LINT_ENABLED=1
LINT_STRICT=0  # basically if lint has ot pass to continue with ci
LINT_CMD=""

FUSESOC_LINT_ENABLED=1
FUSESOC_LINT_TARGET="lint"
FUSESOC_LINT_TOOL="verilator"
FUSESOC_LINT_BUILD_ROOT="rvb_out"
FUSESOC_LINT_EXTRA_ARGS=""


VERIBLE_LINT_ENABLED=1
VERIBLE_RULES_FILE=".rules.verible_lint"
VERIBLE_LINT_EXTENSIONS="sv v vh"
VERIBLE_LINT_EXCLUDE_DIRS="rvb_out fusesoc_libraries riscv-tests embench-1.0 .git"
FUSESOC_LINT_VERILATOR_OPTIONS="-Wno-fatal -Wno-DEPRECATED -Wno-UNOPTFLAT"

# ============================================================
# Synthesis behavior
# ============================================================
#
# Synthesis is intentionally disabled for the first RISCVBusiness CI pass.
#
# First goal:
#
#   setup -> config -> Verilator build -> RISC-V ISA-I tests -> lint
#
# Once that is stable, we can enable real synthesis separately.
# ============================================================

SYNTH_ENABLED=0
SYNTH_MODE="full"
SYNTH_CMD=""
SYNTH_TOP="RISCVBusiness"
SYNTH_OUT_DIR="synth_out"
SYNTH_LIBERTY="flow/lib/NangateOpenCellLibrary_typical.lib"
SYNTH_SDC="rvb.sdc"
SYNTH_OPENSTA_SCRIPT="flow/scripts/opensta_rvb.tcl"